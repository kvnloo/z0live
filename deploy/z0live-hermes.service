# systemd --user unit. Copy to ~/.config/systemd/user/ and replace the placeholders:
#   <repo>         absolute path of this z0live checkout
#   <data-dir>     private z0live data directory outside the repo (e.g. %h/.local/share/z0live), mode 700
#   <hermes-home>  the Hermes profile this host serves (e.g. %h/.hermes or %h/.hermes/profiles/<name>)
[Unit]
Description=z0live native Hermes API-only host (no messaging/schedulers)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=<repo>
Environment=HERMES_HOME=<hermes-home>
Environment=TERMINAL_CWD=<repo>
Environment=Z0LIVE_DATA=<data-dir>
ExecStart=/usr/bin/python3 <repo>/desktop/hermes_host.py
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=180

[Install]
WantedBy=default.target
