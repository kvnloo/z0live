# systemd --user unit. Copy to ~/.config/systemd/user/ and replace the placeholders:
#   <repo>      absolute path of this z0live checkout
#   <data-dir>  private z0live data directory outside the repo (e.g. %h/.local/share/z0live), mode 700
[Unit]
Description=z0live phone voice broker and persistent Hermes bridge
After=network-online.target z0live-hermes.service
Wants=z0live-hermes.service

[Service]
Type=simple
WorkingDirectory=<repo>
Environment=Z0LIVE_DATA=<data-dir>
EnvironmentFile=-<data-dir>/service.env
ExecStart=/usr/bin/python3 <repo>/bin/z0live serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStopSec=45

[Install]
WantedBy=default.target
