  },
  "research_topics": {
    "R01": {
      "claim": "Braid canonical event-sourced task truth; voice does not own a second semantic ledger"
    },
    "R02": {
      "claim": "State Compiler provides minimal sufficient StatePacketDelta plus omission/provenance receipt; transcript remains an audit log"
    },
    "R03": {
      "claim": "Three clocks: 10-80 ms hard media reflex; 80-500 ms interaction policy; 0.2 s-minutes asynchronous cognition"
    },
    "R04": {
      "claim": "Attention policy: SILENT / WHEN_IDLE / INTERRUPT; only current independently verified results may become spoken success"
    },
    "R05": {
      "claim": "PartialIntent can prewarm/retrieve reversibly; only explicit authoritative intent may commit side effects"
    },
    "R06": {
      "claim": "Instrument voice_decision.v1 with overlapping audio and later outcomes; pin frozen replay/certification and protect against data leakage"
    },
    "R07": {
      "claim": "Local research donors: Moshi/Mimi, Lychee-FD, PersonaPlex, MiniCPM-o; prove 3080 Ti 12GB VRAM and p99 streaming deadlines"
    },
    "R08": {
      "claim": "Deterministic floor + attention baseline before learning residual ambiguity; no universal tiny-model router without sealed wins"
    },
    "R09": {
      "claim": "Capability-specific rule->specialist->frontier compile-down only after sealed causal, OOD and outcome evaluation"
    },
    "R10": {
      "claim": "Pinned continuous voice actor stays responsive; OMP/Hermes native agents work asynchronously with verified feedback"
    },
    "R11": {
      "claim": "Authority/idempotency: model text cannot grant tool permission, enqueue != complete != independently verified, stale/cancel uncertain until reconciled"
    },
    "R12": {
      "claim": "OMP /live parity: first *audible* response, actual acoustic stop, overlap/echo, naturalness, p50/p95/p99 and attention burden"
    },
    "R13": {
      "claim": "AEC/playback reference/audio route and hardware tail jitter measured; headless text WebRTC is not mic/speaker proof"
    },
    "R14": {
      "claim": "Consent/revocation/privacy: no mobile driving, microphone or ADB without reauthorization; no public real transcripts/secrets"
    },
    "R15": {
      "claim": "Stable session persona/voice while heterogeneous backend models are invoked; never change actor every turn"
    }
  },
