#!/usr/bin/env python3
"""Standalone desktop CLI; does not replace the portable runtime's package/CLI."""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlencode

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "desktop"))
from z0live_desktop.core import BASE, Store, dumps


def main():
    parser = argparse.ArgumentParser(description="z0live desktop broker")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("serve")
    pair = sub.add_parser("pair")
    pair.add_argument("name")
    pair.add_argument(
        "--qr", action="store_true", help="show QR in terminal (requires qrencode)"
    )
    pair.add_argument(
        "--qr-png", metavar="PATH", help="write private PNG QR (new file only)"
    )
    say = sub.add_parser("say")
    say.add_argument("--session", required=True)
    say.add_argument("text")
    sub.add_parser("devices")
    revoke = sub.add_parser("revoke")
    revoke.add_argument("device_id")
    action = sub.add_parser("action")
    action.add_argument("--session", required=True)
    action.add_argument("--action", required=True)
    action.add_argument("--params", default="{}")
    action.add_argument("--say", default="")
    trace = sub.add_parser(
        "trace", help="Read native stack observations; no model call"
    )
    trace.add_argument("--turn")
    trace.add_argument("--session")
    fanout = sub.add_parser(
        "fanout", help="L2 native-Hermes worker adapter, pinned task role"
    )
    fanout.add_argument("--turn", required=True)
    fanout.add_argument("--brief", action="append", required=True)
    progress = sub.add_parser("progress", help="Queue a short verified partial finding")
    progress.add_argument("--turn", required=True)
    progress.add_argument("text")
    args = parser.parse_args()
    if args.command == "serve":
        from z0live_desktop.server import serve

        return serve()
    store = Store()
    if args.command == "trace":
        print(dumps({"events": store.voice.journal.read(args.turn, args.session)}))
    elif args.command == "fanout":
        print(
            dumps(
                {
                    "turn_id": args.turn,
                    "workers": store.voice.journal.fanout(args.turn, args.brief),
                }
            )
        )
    elif args.command == "progress":
        store.voice.journal.speak(
            args.turn,
            args.text,
            "partial-"
            + __import__("hashlib").sha256(args.text.encode()).hexdigest()[:16],
        )
        store.voice.journal.trace(args.turn, "L2", "partial_finding")
        print(dumps({"status": "queued", "turn_id": args.turn}))
    elif args.command == "pair":
        qr_mode = args.qr or args.qr_png is not None
        encoder = shutil.which("qrencode") if qr_mode else None
        if qr_mode and not encoder:
            parser.error(
                "QR pairing requires qrencode; install it or use pair without QR flags"
            )
        png = None
        token = None
        try:
            if args.qr_png is not None:
                # Refuse overwrites/symlinks and make the credential private from the first byte.
                png = os.fdopen(
                    os.open(args.qr_png, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600),
                    "wb",
                )
            token = store.pair(args.name)
            link = "z0live://pair?" + urlencode({"url": BASE, "token": token})
            if args.qr:
                result = subprocess.run(
                    [encoder, "-t", "ANSIUTF8"],
                    input=link.encode(),
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    check=True,
                )
                sys.stdout.write(result.stdout.decode())
            if png is not None:
                subprocess.run(
                    [encoder, "-t", "PNG", "-s", "8", "-o", "-"],
                    input=link.encode(),
                    stdout=png,
                    stderr=subprocess.DEVNULL,
                    check=True,
                )
                png.flush()
                os.fsync(png.fileno())
            if qr_mode:
                print("Scan with z0live → Scan pairing QR, then confirm the backend.")
                print("Keep the QR private. It grants device access until revoked.")
            else:
                print("Device token: " + token)
                print("Pairing link: " + link)
                print(
                    "Keep this token private. It is only printed once; server stores its SHA-256 verifier."
                )
        except (OSError, ValueError, subprocess.SubprocessError):
            if token is not None:
                store.revoke_token(token)
            if png is not None:
                png.close()
                os.unlink(args.qr_png)
            # Never print subprocess input, exceptions, token, link or credential-bearing paths.
            parser.exit(
                1,
                "Pairing failed; any newly minted token was revoked. Check QR support and output path.\n",
            )
        finally:
            if png is not None and not png.closed:
                png.close()
    elif args.command == "say":
        ident = store.publish(args.text, sid=args.session)
        with store.connect() as db:
            if not db.execute(
                "SELECT 1 FROM inbox WHERE id=? AND session_id=?", (ident, args.session)
            ).fetchone():
                raise RuntimeError("speech readback failed")
        print(dumps({"id": ident, "status": "queued"}))
    elif args.command == "devices":
        path = store.directory / "devices.json"
        devices = json.loads(path.read_text()) if path.exists() else []
        print(
            dumps(
                [
                    {k: d[k] for k in ("id", "name", "created_at", "revoked")}
                    for d in devices
                ]
            )
        )
    elif args.command == "revoke":
        import fcntl
        from z0live_desktop.core import atomic

        lock = os.open(store.directory / ".devices.lock", os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = store.directory / "devices.json"
            devices = json.loads(path.read_text())
            found = False
            for d in devices:
                if d["id"] == args.device_id:
                    d["revoked"] = True
                    found = True
            if not found:
                parser.error("device not found")
            atomic(path, devices)
        finally:
            os.close(lock)
        print("Device revoked")
    elif args.command == "action":
        params = json.loads(args.params)
        with store.connect() as db:
            row = db.execute(
                "SELECT tools FROM sessions WHERE id=?", (args.session,)
            ).fetchone()
        if not row or args.action not in {t["name"] for t in json.loads(row["tools"])}:
            parser.error("action must be declared by that client session")
        print(
            dumps(
                {
                    "id": store.publish(args.say, args.action, params, args.session),
                    "status": "queued",
                }
            )
        )


if __name__ == "__main__":
    main()
