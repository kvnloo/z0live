#!/usr/bin/env python3
"""One-shot tailnet pairing page: pairs a device, serves an https page once that opens z0live://pair.

The chat-safe link carries only a random nonce; the device token is served once, then the server exits.
Usage: z0live-pair-link NAME [--port 8797] [--ttl 900]  (expose with: tailscale serve --bg --set-path /z0pair http://127.0.0.1:8797)
"""
import argparse, html, secrets, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlencode

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "desktop"))
from z0live_desktop.core import BASE, Store

ap = argparse.ArgumentParser()
ap.add_argument("name")
ap.add_argument("--port", type=int, default=8797)
ap.add_argument("--ttl", type=int, default=900)
a = ap.parse_args()
nonce = secrets.token_urlsafe(18)
token = Store().pair(a.name)
link = "z0live://pair?" + urlencode({"url": BASE, "token": token})
served = threading.Event()


class H(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_GET(self):
        if self.path.rstrip("/").split("/")[-1] != nonce or served.is_set():
            self.send_response(404); self.end_headers(); self.wfile.write(b"expired or used"); return
        served.set()
        h = html.escape(link, quote=True)
        body = f"""<!doctype html><meta name=viewport content="width=device-width,initial-scale=1">
<title>Pair z0live</title><body style="font:20px system-ui;background:#111;color:#eee;padding:40px">
<p>Pair this phone with z0live.</p><p><a href="{h}" style="display:inline-block;padding:20px 32px;background:#4af;color:#000;border-radius:14px;text-decoration:none;font-weight:600">Open z0live &amp; pair</a></p>
<p style="font-size:14px;color:#999">Single use. Then confirm in z0live within 30 s.</p></body>"""
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(body.encode())


srv = ThreadingHTTPServer(("127.0.0.1", a.port), H)
print("https://0.taila30dc.ts.net/z0pair/" + nonce, flush=True)
deadline = time.time() + a.ttl
threading.Thread(target=srv.serve_forever, daemon=True).start()
while time.time() < deadline and not served.is_set():
    time.sleep(0.5)
time.sleep(5)
srv.shutdown()
print("served" if served.is_set() else "expired-unserved", flush=True)
