# systemd --user unit. Replace <adapter-dir> with the absolute path of this voice-adapter directory
# (its virtualenv lives at <adapter-dir>/.venv).
[Unit]
Description=Hermes mobile subscription voice compatibility adapter
After=network-online.target hermes-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=<adapter-dir>
ExecStart=<adapter-dir>/.venv/bin/python <adapter-dir>/mobile_live.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
MemoryMax=768M

[Install]
WantedBy=default.target
